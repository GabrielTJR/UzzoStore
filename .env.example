# =====================================================================
# Uzzo Store — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commitar .env.local. Só .env.example é versionado.
# =====================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SOMENTE server-side (worker / route handlers / edge functions). Nunca no client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Linx Microvix (Web Service B2C) — SOMENTE server-side ----
# ATENÇÃO: usuário e senha são FIXOS e PÚBLICOS (vêm impressos na documentação,
# iguais para todos os clientes da Linx). A CHAVE é o segredo inteiro — vale
# como senha de banco. Nunca em NEXT_PUBLIC_*, nunca em client component.
#
# Saída (consulta) = XML simples via POST. A doc V64 grafa a URL sem o "/1.0";
# versões anteriores grafam com. `scripts/microvix-preflight.mjs` testa as duas
# e diz qual responde — ajuste esta variável com o resultado.
MICROVIX_B2C_URL=https://webapi.microvix.com.br/api/integracao
MICROVIX_B2C_USER=linx_b2c
MICROVIX_B2C_PASSWORD=linx_b2c
# Entrada (gravar pedido/cliente) = SOAP, endpoint diferente. Só a partir da
# fase 5; fica aqui para não haver dois lugares de configuração depois.
MICROVIX_ENTRADA_URL=https://webapi.microvix.com.br/importador.svc
MICROVIX_CHAVE=             # chave (UNIQUEIDENTIFIER) emitida pela Linx na ativação — SEGREDO
MICROVIX_CNPJ=              # cnpjEmp: CNPJ da empresa, 14 dígitos, só números
MICROVIX_PORTAL=            # IdPortal: número do portal da loja no Microvix. Vai em TODA requisição
# 1 = apontar para o ambiente de ACEITAÇÃO (webapi-aceitacao), que é uma base
# separada. Deixe vazio para produção.
MICROVIX_ACEITACAO=

# ---- Pagamento: InfinitePay (Checkout Integrado) ----
# Sua InfiniteTag SEM o "$" (aparece no topo do app da InfinitePay).
# É a ÚNICA credencial da API — não existe chave secreta. Por isso o retorno
# do checkout e o webhook NUNCA são acreditados: toda confirmação passa por
# `payment_check` no servidor (src/lib/infinitepay.ts).
INFINITEPAY_HANDLE=

# ---- Pagamento: Mercado Pago (não usado — mantido caso troque de provedor) ----
MERCADOPAGO_ACCESS_TOKEN=            # server-side
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=  # public key (Checkout Bricks, client)
MERCADOPAGO_WEBHOOK_SECRET=          # para validar assinatura do webhook

# ---- Frete: Melhor Envio — SOMENTE server-side ----
# Token gerado no painel do Melhor Envio (Gerenciar -> Tokens). Sem ele a
# cotacao fica indisponivel e a loja volta ao "frete pelo WhatsApp".
MELHORENVIO_TOKEN=
# 1 = usar o sandbox (sandbox.melhorenvio.com.br, conta separada)
MELHORENVIO_SANDBOX=

# ---- E-mail transacional: Resend ----
# Chave de API do Resend (SEGREDO) — usada pelo servidor para os e-mails de
# pedido. Os e-mails de LOGIN saem pelo SMTP configurado no Supabase.
RESEND_API_KEY=
# Remetente; precisa ser de um domínio verificado no Resend.
EMAIL_FROM=
# Para onde vai a resposta do cliente (o EMAIL_FROM costuma ser naoresponda@).
EMAIL_REPLY_TO=Uzzo Store <contato@uzzostore.com.br>

# ---- Admin ----
# E-mails autorizados a acessar /admin (separados por vírgula). Crie o usuário
# correspondente no Supabase (Authentication > Users) com uma senha.
ADMIN_EMAILS=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
