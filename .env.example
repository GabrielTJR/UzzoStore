# =====================================================================
# Uzzo Store — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commitar .env.local. Só .env.example é versionado.
# =====================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SOMENTE server-side (worker / route handlers / edge functions). Nunca no client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Linx Microvix (Web Service B2C) — SOMENTE server-side ----
MICROVIX_B2C_URL=https://webapi.microvix.com.br/1.0/api/integracao
MICROVIX_B2C_USER=linx_b2c
MICROVIX_B2C_PASSWORD=linx_b2c
MICROVIX_CHAVE=              # chave emitida pela Linx para o CNPJ da loja
MICROVIX_CNPJ=              # cnpjEmp

# ---- Pagamento: Mercado Pago ----
MERCADOPAGO_ACCESS_TOKEN=            # server-side
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=  # public key (Checkout Bricks, client)
MERCADOPAGO_WEBHOOK_SECRET=          # para validar assinatura do webhook

# ---- Frete: Melhor Envio — SOMENTE server-side ----
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_TOKEN=

# ---- E-mail transacional: Resend ----
RESEND_API_KEY=

# ---- Admin ----
# E-mails autorizados a acessar /admin (separados por vírgula). Crie o usuário
# correspondente no Supabase (Authentication > Users) com uma senha.
ADMIN_EMAILS=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
